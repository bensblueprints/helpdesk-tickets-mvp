# Deskly configuration — copy to .env and edit

# Port the web app listens on
PORT=5341

# Admin password for the dashboard (change this!)
ADMIN_PASSWORD=change-me

# SQLite database location
DB_PATH=./data/deskly.db

# Public base URL of this install — used in CSAT links inside outbound email
# e.g. https://desk.yourdomain.com
BASE_URL=

# SMTP for outbound replies + CSAT emails (optional — tickets still work without)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IMAP inbox to poll for inbound email → tickets (optional — you can also
# POST to the /inbound/<token> webhook from any mail-forwarding service)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# IMAP poll interval in seconds
IMAP_POLL_SECONDS=60
